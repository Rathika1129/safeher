# SafeHer Environment Variables Template
# Copy this file to .env and supply your credentials

# Firebase Web Client Configuration (Optional for Hackathon Demo mode)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-app-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Notification Service Endpoint (Optional)
# If left unset, SafeHer runs in transparent Hackathon Demo Mode with live carrier simulation
VITE_NOTIFICATION_API_URL=https://your-cloud-functions-url.cloudfunctions.net/dispatchEmergencyAlert
